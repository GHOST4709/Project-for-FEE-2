# Google Maps JavaScript API key (used by the /map page).
# Leave blank and the map falls back to a styled, to-scale preview.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_API_KEY_HERE"

# The app ships with an in-browser mock REST API (axios-mock-adapter) because
# there is no backend. Set VITE_USE_MOCK_API=false and point VITE_API_BASE_URL at
# a real server to use real HTTP instead; no component code has to change.
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=/api

# Dev helper: 0-1 chance that a mock request fails (to see the loading / retry /
# error UI in action). Try 0.4.
VITE_MOCK_FAILURE_RATE=0
